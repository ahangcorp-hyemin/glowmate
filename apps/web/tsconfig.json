{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_note": "REQ-2 — packages/config/tsconfig.base.json 을 extends 해 strict · noUncheckedIndexedAccess · noImplicitOverride 를 상속한다. 아래 compilerOptions 는 Next(App Router) 가 요구하는 값만 덮어쓰며, 위 세 플래그는 재선언하지 않는다.",
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "next.config.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
