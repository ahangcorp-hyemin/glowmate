# Supabase (호스티드). supabase.com 프로젝트 → Settings → API 에서 복사.
# 이 파일을 .env.local 로 복사해 값을 채우세요. .env.local 은 커밋 금지.

# 프로젝트 URL (https://xxxx.supabase.co)
SUPABASE_URL=

# service_role 키 (서버 전용 · 절대 클라이언트 노출 금지). 시드/서버 액션이 사용.
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 브라우저용 anon 키 — 현재 서버 액션만 쓰므로 필수 아님.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
