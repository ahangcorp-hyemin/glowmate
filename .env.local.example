# 이 파일을 .env.local 로 복사해 값을 채우세요. .env.local 은 커밋 금지.
# 모두 서버 전용 키 — 절대 클라이언트(NEXT_PUBLIC_)로 노출하지 마세요.

# ── Supabase (DB) ── supabase.com → 프로젝트 → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 공공데이터포털 (HIRA 병원·비급여 실데이터) ──
# data.go.kr 가입 → 아래 두 데이터셋 '활용신청' → 마이페이지에서 인증키 복사
#   병원정보서비스     https://www.data.go.kr/data/15001698/openapi.do
#   비급여진료비정보   https://www.data.go.kr/data/15001700/openapi.do
DATA_GO_KR_SERVICE_KEY=

# ── Kakao Local (좌표→지역명, 지도 링크) ──
# developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=
